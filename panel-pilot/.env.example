# Image/build identity. Set BUILD_ID to the source commit for releases.
PANELS_IMAGE_TAG=local
PANELS_BUILD_ID=local

# Panels is bound to loopback by default. Put an HTTPS reverse proxy in front.
PANELS_BIND_ADDRESS=127.0.0.1
PANELS_PORT=8013

# Required when Panels is reachable by anyone other than the machine owner.
PANEL_PILOT_AUTH_USER=reader
# Intentionally blank: use at least 16 characters. Compose refuses to start
# until both credentials are set.
PANEL_PILOT_AUTH_PASSWORD=
# Generate a distinct 32-byte value with `openssl rand -hex 32`.
PANEL_PILOT_SESSION_SECRET=
PANEL_PILOT_SESSION_MAX_AGE=2592000

# From the Panels container, this must resolve to Suwayomi's GraphQL server.
# host.docker.internal works with the compose.yaml extra_hosts entry when
# Suwayomi publishes port 4567 on the Docker host.
SUWAYOMI_INTERNAL_URL=http://host.docker.internal:4567
# Leave both values empty when Suwayomi does not use Basic Auth.
SUWAYOMI_AUTH_USER=
SUWAYOMI_AUTH_PASSWORD=

# Optional server-side MangaBaka token. It can instead be entered in Settings.
MANGABAKA_API_KEY=

# Optional Western-comics recommendation feed. Get a LibraryThing developer
# key, then identify Open Library requests with an email address or project URL.
PANEL_PILOT_LIBRARYTHING_API_KEY=
PANEL_PILOT_OPEN_LIBRARY_CONTACT=

# Optional server-side manga detector. Uncomment both lines to enable its
# Compose profile; otherwise Panels uses its built-in browser detector.
# COMPOSE_PROFILES=manga-detector
# PANEL_PILOT_MANGA_DETECTOR_URL=http://manga-detector:8091
MANGA_SCORE_THRESHOLD=0.25
MANGA_INPUT_SIZE=1024
COMIC_SCORE_THRESHOLD=0.25
COMIC_NMS_THRESHOLD=0.45
COMIC_INPUT_SIZE=640

# Optional EPUB books integration. With this false, no books database or
# background work is started and the existing app behaves as before.
BOOKS_ENABLED=false
# Use internal Compose hostnames when enabling the `books` profile.
SHELFMARK_BASE_URL=http://shelfmark:8084
# Generate a distinct key; this is shared only by Panels and Shelfmark.
SHELFMARK_API_KEY=
# Optional Anna's Archive fast-download key. Set this only in the server .env;
# it is passed to Shelfmark and never to Panels or the browser.
AA_DONATOR_KEY=
CWA_OPDS_URL=http://calibre-web-automated:8083/opds
CWA_USERNAME=
CWA_PASSWORD=
BOOK_SYNC_INTERVAL_SECONDS=300
# Enable the optional services with COMPOSE_PROFILES=books (or include it in a
# comma-separated profile list such as manga-detector,books).
BOOKS_PUID=1000
BOOKS_PGID=1000
SHELFMARK_PORT=8084
CWA_PORT=8083
